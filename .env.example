# Copy this file to .env (untracked, see .gitignore) and fill in real values
# before running `docker compose up --build`.

# Symmetric signing key for JWT bearer tokens (TokenService.GenerateToken /
# Program.cs read Jwt:Key with no fallback — required, no default in
# appsettings.json). Use a long random secret, e.g. `openssl rand -base64 48`.
JWT_KEY=replace-with-a-long-random-secret
