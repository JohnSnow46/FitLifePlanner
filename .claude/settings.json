{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Write",
      "Edit",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(dotnet --version)",
      "Bash(dotnet new *)",
      "Bash(dotnet sln *)",
      "Bash(dotnet restore*)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet run*)",
      "Bash(dotnet ef*)",
      "Bash(dotnet tool install*)"
    ],
    "deny": [
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git add -u)",
      "Bash(git add -u *)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git add :/)",
      "Bash(git add :/ *)"
    ]
  }
}
