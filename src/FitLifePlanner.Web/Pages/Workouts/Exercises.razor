@page "/exercises"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using FitLifePlanner.Web.Contracts.Workouts
@using FitLifePlanner.Web.Services
@inject WorkoutsApiClient WorkoutsApiClient

<PageTitle>Exercises</PageTitle>

<h1>Exercises</h1>

<ErrorAlert Message="@errorMessage" />

<div class="row mb-3">
    <div class="col">
        <label for="nameFilter" class="form-label">Filter by name</label>
        <input id="nameFilter" class="form-control" @bind="nameFilter" @bind:event="oninput" />
    </div>
    <div class="col">
        <label for="muscleGroupFilter" class="form-label">Filter by muscle group</label>
        <input id="muscleGroupFilter" class="form-control" @bind="muscleGroupFilter" @bind:event="oninput" />
    </div>
</div>

@if (isLoading)
{
    <LoadingIndicator />
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th></th>
                <th>Name</th>
                <th>Muscle group</th>
                <th>Description</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var exercise in VisibleExercises)
            {
                <tr>
                    <td>
                        <button type="button" class="btn btn-sm btn-link p-0" aria-label="@(exercise.IsFavorite ? "Remove from favorites" : "Mark as favorite")" aria-pressed="@exercise.IsFavorite" @onclick="() => ToggleFavoriteAsync(exercise)">
                            <span aria-hidden="true">@(exercise.IsFavorite ? "★" : "☆")</span>
                        </button>
                    </td>
                    <td>@exercise.Name</td>
                    <td>@exercise.MuscleGroup</td>
                    <td>@exercise.Description</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="() => StartEdit(exercise)">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteExerciseAsync(exercise.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2>@(editingId is null ? "Add exercise" : "Edit exercise")</h2>

    <EditForm Model="formModel" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <InputText id="name" class="form-control" @bind-Value="formModel.Name" />
        </div>

        <div class="mb-3">
            <label for="muscleGroup" class="form-label">Muscle group</label>
            <InputText id="muscleGroup" class="form-control" @bind-Value="formModel.MuscleGroup" />
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <InputTextArea id="description" class="form-control" @bind-Value="formModel.Description" />
        </div>

        <button type="submit" class="btn btn-primary">@(editingId is null ? "Add" : "Save")</button>
        @if (editingId is not null)
        {
            <button type="button" class="btn btn-outline-secondary ms-2" @onclick="CancelEdit">Cancel</button>
        }
    </EditForm>
}

@code {
    private IReadOnlyCollection<ExerciseResponse> exercises = [];
    private string? nameFilter;
    private string? muscleGroupFilter;
    private int? editingId;
    private readonly ExerciseFormModel formModel = new();
    private bool isLoading;
    private string? errorMessage;

    /// Name filter mirrors Foods.razor's (which was itself modeled on this page's muscle-group
    /// filter) -- both filters combine, so "press" + "chest" narrows to chest presses.
    private IEnumerable<ExerciseResponse> VisibleExercises =>
        exercises
        .Where(e => string.IsNullOrWhiteSpace(nameFilter)
            || e.Name.Contains(nameFilter.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(e => string.IsNullOrWhiteSpace(muscleGroupFilter)
            || e.MuscleGroup.Contains(muscleGroupFilter.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(e => e.IsFavorite)
        .ThenBy(e => e.Name);

    protected override async Task OnInitializedAsync()
    {
        await LoadExercisesAsync();
    }

    private async Task LoadExercisesAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            exercises = await WorkoutsApiClient.GetExercisesAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartEdit(ExerciseResponse exercise)
    {
        editingId = exercise.Id;
        formModel.Name = exercise.Name;
        formModel.MuscleGroup = exercise.MuscleGroup;
        formModel.Description = exercise.Description;
    }

    private void CancelEdit()
    {
        editingId = null;
        formModel.Name = string.Empty;
        formModel.MuscleGroup = string.Empty;
        formModel.Description = string.Empty;
    }

    private async Task HandleSubmitAsync()
    {
        errorMessage = null;
        try
        {
            if (editingId is null)
            {
                await WorkoutsApiClient.CreateExerciseAsync(new CreateExerciseRequest
                {
                    Name = formModel.Name,
                    MuscleGroup = formModel.MuscleGroup,
                    Description = formModel.Description
                });
            }
            else
            {
                await WorkoutsApiClient.UpdateExerciseAsync(editingId.Value, new UpdateExerciseRequest
                {
                    Name = formModel.Name,
                    MuscleGroup = formModel.MuscleGroup,
                    Description = formModel.Description
                });
            }

            CancelEdit();
            await LoadExercisesAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task ToggleFavoriteAsync(ExerciseResponse exercise)
    {
        errorMessage = null;
        try
        {
            await WorkoutsApiClient.SetExerciseFavoriteAsync(exercise.Id, !exercise.IsFavorite);
            await LoadExercisesAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DeleteExerciseAsync(int id)
    {
        errorMessage = null;
        try
        {
            await WorkoutsApiClient.DeleteExerciseAsync(id);
            await LoadExercisesAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class ExerciseFormModel
    {
        [Required]
        [MaxLength(200)]
        public string Name { get; set; } = string.Empty;

        [Required]
        [MaxLength(100)]
        public string MuscleGroup { get; set; } = string.Empty;

        [Required]
        [MaxLength(2000)]
        public string Description { get; set; } = string.Empty;
    }
}
