@page "/meal-plans"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using FitLifePlanner.Web.Contracts.Nutrition
@using FitLifePlanner.Web.Services
@inject NutritionApiClient NutritionApiClient

<PageTitle>Meal Plans</PageTitle>

<h1>Meal Plans</h1>

<ErrorAlert Message="@errorMessage" />

<div class="mb-3">
    <label for="nameFilter" class="form-label">Filter by name</label>
    <input id="nameFilter" class="form-control" @bind="nameFilter" @bind:event="oninput" />
</div>

@if (isLoading)
{
    <LoadingIndicator />
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var plan in VisiblePlans)
            {
                <tr>
                    <td>@plan.Name</td>
                    <td><a href="/meal-plans/@plan.Id">Details</a></td>
                    <td><button type="button" class="btn btn-link p-0" @onclick="() => DuplicateAsync(plan.Id)">Duplicate</button></td>
                </tr>
            }
        </tbody>
    </table>

    <h2>New plan</h2>

    <EditForm Model="formModel" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <InputText id="name" class="form-control" @bind-Value="formModel.Name" />
        </div>

        <button type="submit" class="btn btn-primary">Create</button>
    </EditForm>
}

@code {
    private IReadOnlyCollection<MealPlanResponse> plans = [];
    private string? nameFilter;
    private readonly MealPlanFormModel formModel = new();
    private bool isLoading;
    private string? errorMessage;

    // Same name filter WorkoutPlans got on 2026-10-27 -- this list grows the same way
    // (each Duplicate adds another "(Copy)" plan).
    private IEnumerable<MealPlanResponse> VisiblePlans =>
        string.IsNullOrWhiteSpace(nameFilter)
            ? plans
            : plans.Where(p => p.Name.Contains(nameFilter.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadPlansAsync();
    }

    private async Task LoadPlansAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            plans = await NutritionApiClient.GetMealPlansAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DuplicateAsync(int id)
    {
        errorMessage = null;
        try
        {
            await NutritionApiClient.DuplicateMealPlanAsync(id);
            await LoadPlansAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task HandleSubmitAsync()
    {
        errorMessage = null;
        try
        {
            await NutritionApiClient.CreateMealPlanAsync(new CreateMealPlanRequest { Name = formModel.Name });
            formModel.Name = string.Empty;
            await LoadPlansAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class MealPlanFormModel
    {
        [Required]
        [MaxLength(200)]
        public string Name { get; set; } = string.Empty;
    }
}
