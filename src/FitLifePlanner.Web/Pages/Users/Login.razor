@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using FitLifePlanner.Web.Contracts.Users
@using FitLifePlanner.Web.Services
@inject UsersApiClient UsersApiClient
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Log in</PageTitle>

<h1>Log in</h1>

<ErrorAlert Message="@errorMessage" />

@if (isLoading)
{
    <LoadingIndicator />
}
else
{
    <EditForm Model="formModel" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" class="form-control" @bind-Value="formModel.Email" />
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <InputText id="password" type="password" class="form-control" @bind-Value="formModel.Password" />
        </div>

        <button type="submit" class="btn btn-primary">Log in</button>
    </EditForm>
}

<p class="mt-3"><a href="/register">Don't have an account? Register</a></p>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly LoginFormModel formModel = new();
    private bool isLoading;
    private string? errorMessage;

    private async Task HandleSubmitAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var response = await UsersApiClient.LoginAsync(new UserLoginRequest
            {
                Email = formModel.Email,
                Password = formModel.Password
            });
            await AuthStateProvider.SignIn(response.Token);
            NavigationManager.NavigateTo(IsSafeReturnUrl(ReturnUrl) ? ReturnUrl! : "/");
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static bool IsSafeReturnUrl(string? returnUrl) =>
        !string.IsNullOrEmpty(returnUrl)
        && returnUrl.StartsWith('/')
        && !returnUrl.StartsWith("//", StringComparison.Ordinal)
        && Uri.TryCreate(returnUrl, UriKind.Relative, out _);

    private sealed class LoginFormModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
