@page "/register"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using FitLifePlanner.Web.Contracts.Users
@using FitLifePlanner.Web.Services
@inject UsersApiClient UsersApiClient
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Register</PageTitle>

<h1>Register</h1>

<ErrorAlert Message="@errorMessage" />

@if (isLoading)
{
    <LoadingIndicator />
}
else
{
    <EditForm Model="formModel" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <InputText id="name" class="form-control" @bind-Value="formModel.Name" />
        </div>

        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" class="form-control" @bind-Value="formModel.Email" />
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <InputText id="password" type="password" class="form-control" @bind-Value="formModel.Password" />
        </div>

        <button type="submit" class="btn btn-primary">Register</button>
    </EditForm>
}

<p class="mt-3"><a href="/login">Already have an account? Log in</a></p>

@code {
    private readonly RegisterFormModel formModel = new();
    private bool isLoading;
    private string? errorMessage;

    private async Task HandleSubmitAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var response = await UsersApiClient.RegisterAsync(new UserRegisterRequest
            {
                Name = formModel.Name,
                Email = formModel.Email,
                Password = formModel.Password
            });
            await AuthStateProvider.SignIn(response.Token);
            NavigationManager.NavigateTo("/");
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed class RegisterFormModel
    {
        [Required]
        public string Name { get; set; } = string.Empty;

        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [MinLength(8)]
        public string Password { get; set; } = string.Empty;
    }
}
