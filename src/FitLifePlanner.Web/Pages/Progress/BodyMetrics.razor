@page "/body-metrics"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using FitLifePlanner.Web.Contracts.Progress
@using FitLifePlanner.Web.Contracts.Users
@using FitLifePlanner.Web.Services
@inject ProgressApiClient ProgressApiClient
@inject UsersApiClient UsersApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Body Metrics</PageTitle>

<h1>Body Metrics</h1>

<ErrorAlert Message="@errorMessage" />

<h2>Goal</h2>

<EditForm Model="goalsFormModel" OnValidSubmit="HandleSaveGoalsAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row mb-3">
        <div class="col-auto">
            <label for="targetWeight" class="form-label">Target weight</label>
            <InputNumber id="targetWeight" class="form-control" @bind-Value="goalsFormModel.TargetWeight" />
        </div>
        <div class="col-auto">
            <label for="targetBodyFatPercent" class="form-label">Target body fat %</label>
            <InputNumber id="targetBodyFatPercent" class="form-control" @bind-Value="goalsFormModel.TargetBodyFatPercent" />
        </div>
        <div class="col-auto align-self-end">
            <button type="submit" class="btn btn-outline-primary">Save goal</button>
        </div>
    </div>
</EditForm>

@if (latestEntry is not null && goalsFormModel.TargetWeight is decimal targetWeight)
{
    var remaining = latestEntry.Weight - targetWeight;
    <p>
        Latest weight @latestEntry.Weight, target @targetWeight —
        @if (remaining == 0)
        {
            <strong>goal reached.</strong>
        }
        else
        {
            <strong>@Math.Abs(remaining).ToString("0.##") @(remaining > 0 ? "to lose" : "to gain").</strong>
        }
    </p>
}

<div class="row mb-3">
    <div class="col-auto">
        <label for="from" class="form-label">From</label>
        <input id="from" type="date" class="form-control" @bind="fromFilter" />
    </div>
    <div class="col-auto">
        <label for="to" class="form-label">To</label>
        <input id="to" type="date" class="form-control" @bind="toFilter" />
    </div>
    <div class="col-auto align-self-end">
        <button type="button" class="btn btn-outline-secondary" @onclick="LoadEntriesAsync">Filter</button>
    </div>
    <div class="col-auto align-self-end">
        <button type="button" class="btn btn-outline-secondary" @onclick="DownloadCsvAsync">Download CSV</button>
    </div>
</div>

@if (isLoading)
{
    <LoadingIndicator />
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Weight</th>
                <th>Body fat %</th>
                <th>Notes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in entries)
            {
                <tr>
                    <td>@entry.Date.ToLocalTime().ToString("d")</td>
                    <td>@entry.Weight</td>
                    <td>@entry.BodyFatPercent</td>
                    <td>@entry.Notes</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteEntryAsync(entry.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2>New entry</h2>

    <EditForm Model="formModel" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="date" class="form-label">Date</label>
            <InputDate id="date" class="form-control" @bind-Value="formModel.Date" />
        </div>

        <div class="mb-3">
            <label for="weight" class="form-label">Weight</label>
            <InputNumber id="weight" class="form-control" @bind-Value="formModel.Weight" />
        </div>

        <div class="mb-3">
            <label for="bodyFatPercent" class="form-label">Body fat %</label>
            <InputNumber id="bodyFatPercent" class="form-control" @bind-Value="formModel.BodyFatPercent" />
        </div>

        <div class="mb-3">
            <label for="notes" class="form-label">Notes</label>
            <InputText id="notes" class="form-control" @bind-Value="formModel.Notes" />
        </div>

        <button type="submit" class="btn btn-primary">Create</button>
    </EditForm>
}

@code {
    private IReadOnlyCollection<BodyMetricEntryResponse> entries = [];
    private readonly BodyMetricEntryFormModel formModel = new();
    private readonly GoalsFormModel goalsFormModel = new();
    private DateTime? fromFilter;
    private DateTime? toFilter;
    private bool isLoading;
    private string? errorMessage;

    private BodyMetricEntryResponse? latestEntry =>
        entries.OrderByDescending(e => e.Date).FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        await LoadEntriesAsync();
        await LoadGoalsAsync();
    }

    private async Task LoadGoalsAsync()
    {
        try
        {
            var user = await UsersApiClient.GetCurrentUserAsync();
            goalsFormModel.TargetWeight = user.TargetWeight;
            goalsFormModel.TargetBodyFatPercent = user.TargetBodyFatPercent;
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task HandleSaveGoalsAsync()
    {
        errorMessage = null;
        try
        {
            await UsersApiClient.UpdateGoalsAsync(new UpdateBodyGoalsRequest
            {
                TargetWeight = goalsFormModel.TargetWeight,
                TargetBodyFatPercent = goalsFormModel.TargetBodyFatPercent
            });
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadEntriesAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            entries = await ProgressApiClient.GetBodyMetricEntriesAsync(fromFilter, toFilter);
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmitAsync()
    {
        errorMessage = null;
        try
        {
            await ProgressApiClient.CreateBodyMetricEntryAsync(new CreateBodyMetricEntryRequest
            {
                Date = formModel.Date,
                Weight = formModel.Weight,
                BodyFatPercent = formModel.BodyFatPercent,
                Notes = formModel.Notes
            });
            formModel.Date = DateTime.Today;
            formModel.Weight = 0;
            formModel.BodyFatPercent = null;
            formModel.Notes = string.Empty;
            await LoadEntriesAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DownloadCsvAsync()
    {
        errorMessage = null;
        try
        {
            var csv = await ProgressApiClient.ExportBodyMetricEntriesCsvAsync(fromFilter, toFilter);
            await JsRuntime.InvokeVoidAsync("downloadFile", "body-metrics.csv", "text/csv", csv);
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DeleteEntryAsync(int id)
    {
        errorMessage = null;
        try
        {
            await ProgressApiClient.DeleteBodyMetricEntryAsync(id);
            await LoadEntriesAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private sealed class BodyMetricEntryFormModel
    {
        [Required]
        public DateTime Date { get; set; } = DateTime.Today;

        [Range(0.01, double.MaxValue)]
        public decimal Weight { get; set; }

        public decimal? BodyFatPercent { get; set; }

        public string Notes { get; set; } = string.Empty;
    }

    private sealed class GoalsFormModel
    {
        [Range(0.01, double.MaxValue)]
        public decimal? TargetWeight { get; set; }

        [Range(0, 100)]
        public decimal? TargetBodyFatPercent { get; set; }
    }
}
