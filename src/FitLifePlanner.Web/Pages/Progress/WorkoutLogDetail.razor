@page "/workout-logs/{LogId:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using FitLifePlanner.Web.Contracts.Progress
@using FitLifePlanner.Web.Contracts.Workouts
@using FitLifePlanner.Web.Services
@inject ProgressApiClient ProgressApiClient
@inject WorkoutsApiClient WorkoutsApiClient
@inject NavigationManager NavigationManager

@* Same as the plan detail pages: the log's date (its heading) in the tab, not just "Workout Log". *@
<PageTitle>@(log is null ? "Workout Log" : $"{log.Date.ToLocalTime():d} - Workout Log")</PageTitle>

<ErrorAlert Message="@errorMessage" />

@if (isLoading)
{
    <LoadingIndicator />
}
else if (log is not null)
{
    <h1>@log.Date.ToLocalTime().ToString("d")</h1>
    <p>@log.Notes</p>
    <p>
        Workout plan:
        @if (PlanExists(log.WorkoutPlanId))
        {
            <a href="/workout-plans/@log.WorkoutPlanId">@PlanName(log.WorkoutPlanId)</a>
        }
        else
        {
            @PlanName(log.WorkoutPlanId)
        }
    </p>
    @if (log.WorkoutPlanId is not null && log.Entries.Count == 0)
    {
        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@isCopyingPlan" @onclick="CopyPlannedExercisesAsync">
            @(isCopyingPlan ? "Copying..." : "Copy planned exercises")
        </button>
    }

    <h2 class="mt-4">Entries</h2>

    <table class="table">
        <thead>
            <tr>
                <th>Exercise</th>
                <th>Sets</th>
                <th>Reps</th>
                <th>Weight</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in log.Entries)
            {
                <tr>
                    <td>@ExerciseName(entry.ExerciseId)</td>
                    <td>@entry.SetsCompleted</td>
                    <td>@entry.RepsCompleted</td>
                    <td>@entry.WeightUsed</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveEntryAsync(entry.Id)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
        @if (log.Entries.Count > 0)
        {
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="3">Log totals</td>
                    <td colspan="2">@FormatVolume(LogTotalVolume)</td>
                </tr>
            </tfoot>
        }
    </table>

    <h3>Add entry</h3>

    <EditForm Model="addEntryFormModel" OnValidSubmit="HandleAddEntryAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="exercise" class="form-label">Exercise</label>
            <InputSelect id="exercise" class="form-select" @bind-Value="addEntryFormModel.ExerciseId">
                <option value="0">-- select --</option>
                @foreach (var exercise in ExerciseCatalogForPicker)
                {
                    <option value="@exercise.Id">@(exercise.IsFavorite ? "★ " : "")@exercise.Name</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label for="setsCompleted" class="form-label">Sets completed</label>
            <InputNumber id="setsCompleted" class="form-control" @bind-Value="addEntryFormModel.SetsCompleted" />
        </div>

        <div class="mb-3">
            <label for="repsCompleted" class="form-label">Reps completed</label>
            <InputNumber id="repsCompleted" class="form-control" @bind-Value="addEntryFormModel.RepsCompleted" />
        </div>

        <div class="mb-3">
            <label for="weightUsed" class="form-label">Weight used</label>
            <InputNumber id="weightUsed" class="form-control" @bind-Value="addEntryFormModel.WeightUsed" />
        </div>

        @if (PendingEntryVolume is { } pendingVolume)
        {
            <p class="text-muted">This entry adds: @FormatVolume(pendingVolume)</p>
        }

        <button type="submit" class="btn btn-primary">Add entry</button>
    </EditForm>

    <h2 class="mt-4">Danger zone</h2>

    @if (confirmingDelete)
    {
        <p>Are you sure you want to delete this log?</p>
        <button type="button" class="btn btn-danger me-2" @onclick="DeleteLogAsync">Confirm delete</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => confirmingDelete = false">Cancel</button>
    }
    else
    {
        <button type="button" class="btn btn-outline-danger" @onclick="() => confirmingDelete = true">Delete log</button>
    }
}

@code {
    [Parameter]
    public int LogId { get; set; }

    private WorkoutLogDetailResponse? log;
    private IReadOnlyCollection<WorkoutPlanResponse> workoutPlans = [];
    private IReadOnlyCollection<ExerciseResponse> exerciseCatalog = [];
    private readonly AddEntryFormModel addEntryFormModel = new();
    private bool isLoading;
    private bool confirmingDelete;
    private bool isCopyingPlan;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            log = await ProgressApiClient.GetWorkoutLogAsync(LogId);
            workoutPlans = await WorkoutsApiClient.GetWorkoutPlansAsync();
            exerciseCatalog = await WorkoutsApiClient.GetExercisesAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    /// Links to the plan only while it still exists -- a deleted plan keeps PlanName's "#id"
    /// fallback as plain text rather than a link to a 404.
    private bool PlanExists(int? workoutPlanId) =>
        workoutPlanId is not null && workoutPlans.Any(p => p.Id == workoutPlanId);

    private string PlanName(int? workoutPlanId) =>
        workoutPlanId is null
            ? "-"
            : workoutPlans.FirstOrDefault(p => p.Id == workoutPlanId)?.Name ?? $"#{workoutPlanId}";

    private string ExerciseName(int exerciseId) =>
        exerciseCatalog.FirstOrDefault(e => e.Id == exerciseId)?.Name ?? $"#{exerciseId}";

    /// Favorites first (same ordering as the Exercises catalog page and WorkoutPlanDetail's
    /// own exercise picker) so this picker surfaces a user's go-to exercises too.
    private IEnumerable<ExerciseResponse> ExerciseCatalogForPicker =>
        exerciseCatalog.OrderByDescending(e => e.IsFavorite).ThenBy(e => e.Name);

    /// Same "sets x reps x weight, summed" formula as ProgressMappings.TotalVolume
    /// (WorkoutLogResponse, used by the Workout Logs list/trend chart) and as
    /// WorkoutPlanDetail's own PlanTotalVolume (over targets instead of completed sets) --
    /// WorkoutLogDetail never showed the same total for the entries it's actually editing.
    private decimal LogTotalVolume =>
        log is null
            ? 0
            : log.Entries.Sum(e => e.SetsCompleted * e.RepsCompleted * e.WeightUsed);

    /// Same "this exercise adds: ..." live preview WorkoutPlanDetail already has while
    /// building a plan, over the entry actually being logged instead of a planned target.
    private decimal? PendingEntryVolume =>
        addEntryFormModel.ExerciseId <= 0 || addEntryFormModel.SetsCompleted <= 0 || addEntryFormModel.RepsCompleted <= 0
            ? null
            : addEntryFormModel.SetsCompleted * addEntryFormModel.RepsCompleted * addEntryFormModel.WeightUsed;

    private static string FormatVolume(decimal volume) => $"{volume:0.#} total volume (sets × reps × weight)";

    private async Task HandleAddEntryAsync()
    {
        errorMessage = null;
        try
        {
            await ProgressApiClient.AddWorkoutLogEntryAsync(LogId, new AddWorkoutLogEntryRequest
            {
                ExerciseId = addEntryFormModel.ExerciseId,
                SetsCompleted = addEntryFormModel.SetsCompleted,
                RepsCompleted = addEntryFormModel.RepsCompleted,
                WeightUsed = addEntryFormModel.WeightUsed
            });
            addEntryFormModel.ExerciseId = 0;
            addEntryFormModel.SetsCompleted = 0;
            addEntryFormModel.RepsCompleted = 0;
            addEntryFormModel.WeightUsed = 0;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    /// A log linked to a plan started empty, so logging "the plan as written" meant re-entering
    /// every exercise by hand. Copies each planned exercise (in plan order) as an entry with its
    /// target sets/reps/weight, which the user then adjusts to what they actually did. Only
    /// offered on an empty log, so it can't silently duplicate entries.
    private async Task CopyPlannedExercisesAsync()
    {
        if (log?.WorkoutPlanId is not int planId)
        {
            return;
        }

        errorMessage = null;
        isCopyingPlan = true;
        try
        {
            var plan = await WorkoutsApiClient.GetWorkoutPlanAsync(planId);
            foreach (var planned in plan.Exercises.OrderBy(e => e.Order))
            {
                await ProgressApiClient.AddWorkoutLogEntryAsync(LogId, new AddWorkoutLogEntryRequest
                {
                    ExerciseId = planned.ExerciseId,
                    SetsCompleted = planned.TargetSets,
                    RepsCompleted = planned.TargetReps,
                    WeightUsed = planned.TargetWeight
                });
            }
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            // Some entries may already have been added before the failure -- reload so the table
            // shows them, then surface the error (LoadAsync clears errorMessage itself).
            await LoadAsync();
            errorMessage = ex.Message;
        }
        finally
        {
            isCopyingPlan = false;
        }
    }

    private async Task RemoveEntryAsync(int entryId)
    {
        errorMessage = null;
        try
        {
            await ProgressApiClient.RemoveWorkoutLogEntryAsync(LogId, entryId);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DeleteLogAsync()
    {
        errorMessage = null;
        try
        {
            await ProgressApiClient.DeleteWorkoutLogAsync(LogId);
            NavigationManager.NavigateTo("/workout-logs");
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
            confirmingDelete = false;
        }
    }

    private sealed class AddEntryFormModel
    {
        [Range(1, int.MaxValue, ErrorMessage = "Select an exercise.")]
        public int ExerciseId { get; set; }

        [Range(1, int.MaxValue)]
        public int SetsCompleted { get; set; }

        [Range(1, int.MaxValue)]
        public int RepsCompleted { get; set; }

        [Range(0, double.MaxValue)]
        public decimal WeightUsed { get; set; }
    }
}
