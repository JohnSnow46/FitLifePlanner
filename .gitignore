.DS_Store
Thumbs.db

# Secrets / local env — never commit actual values
.env
.env.*
!.env.example

# .NET build output
bin/
obj/

# SQLite local dev database (ADR-0002) — never committed
*.db
*.db-shm
*.db-wal

# Generic build/dependency output
node_modules/
dist/
build/
*.log

# Personal overrides — .claude/ itself is meant to be committed (see README),
# but settings.local.json is per-developer and must never be.
.claude/settings.local.json

# prompt-runner working artifacts — local run history, not project content
tools/prompt-runner/logs/
